{
  "appId": "com.podtech.jagdamba",
  "appName": "Jagdamba",
  "webDir": "build",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#02050F",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
